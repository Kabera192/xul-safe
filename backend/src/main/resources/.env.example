DB_URL=jdbc:postgresql://the-host:pg_port/database
DB_USER=pg_username
DB_PWD=pg_pwd
JWT_SECRET=the-actual-jwt-secret
JWT_ISSUER=the-actual-jwt-issuer

# Email OTP (password reset + account verification). Leave these blank to
# use the EMAIL-DEV console fallback instead of sending real emails.
# Port 465+SSL is the default since some networks block 587 (STARTTLS)
# outright; switch to MAIL_PORT=587, MAIL_SSL=false, MAIL_STARTTLS=true if
# your provider requires STARTTLS instead.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USERNAME=the-sending-email-address
MAIL_PASSWORD=the-smtp-password-or-app-password
MAIL_FROM=the-sending-email-address